# Copy to backend/.env (never commit it) or set these in Render / your shell.
# Values below are placeholders — generate real secrets yourself.

DATABASE_URL=jdbc:postgresql://localhost:5432/borcdefteri
DATABASE_USERNAME=borcdefteri
DATABASE_PASSWORD=change-me
DB_POOL_SIZE=10

# Required. At least 32 characters. Example generator: openssl rand -base64 48
JWT_SECRET=replace-with-32+-character-random-secret
JWT_EXPIRATION_MINUTES=720

# Comma-separated list of web origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# First platform administrator, created only if no SUPER_ADMIN exists yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-12+-character-password
ADMIN_NAME=Platforma Administratoru

# Receipt uploads (PNG/JPG/PDF, max 5 MB). Use a persistent path in production.
UPLOAD_DIR=./uploads

AUTH_RATE_LIMIT_PER_MINUTE=20
PORT=8080

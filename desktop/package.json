{
  "name": "hesabpro-kassa",
  "productName": "HesabPro Kassa",
  "version": "1.0.0",
  "description": "HesabPro satış kassası — Windows proqramı",
  "main": "main.js",
  "author": "HesabPro",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "dist:store": "electron-builder --win appx --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "az.hesabpro.kassa",
    "productName": "HesabPro Kassa",
    "artifactName": "HesabPro-Kassa-Setup.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "scale.js",
      "offline.html",
      "package.json",
      "!build/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HesabPro Kassa"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/BTB60/borcdefderi/releases/download/desktop-latest/"
      }
    ],
    "appx": {
      "applicationId": "HesabProKassa",
      "displayName": "HesabPro Kassa",
      "identityName": "HesabPro.Kassa",
      "publisher": "CN=00000000-0000-0000-0000-000000000000",
      "publisherDisplayName": "HesabPro",
      "backgroundColor": "#0F1B33",
      "languages": [
        "az-AZ",
        "en-US"
      ],
      "artifactName": "HesabPro-Kassa-Store.${ext}"
    }
  }
}
